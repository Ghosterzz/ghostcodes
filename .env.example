# MongoDB Atlas connection string. Use a database user limited to this database.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/ghostcodes?retryWrites=true&w=majority&authSource=admin

# Create a Discord application, then set its OAuth2 client ID and secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a Redirect URI in the Discord Developer Portal.
DISCORD_REDIRECT_URI=http://localhost:8888/auth/callback
# Comma-separated Discord user IDs allowed to manage projects.
DISCORD_ADMIN_USER_IDS=

# Optional: require community-server membership for member access.
DISCORD_GUILD_ID=
# Optional: when set, require this role in that server for member-only projects.
DISCORD_MEMBER_ROLE_ID=

# Optional: a bot with Send Messages and Embed Links in the reports channel.
DISCORD_BOT_TOKEN=
DISCORD_BUG_CHANNEL_ID=
# Public website base URL used by the bot's /projects command.
WEBSITE_URL=https://YOUR-SITE-DOMAIN
# Optional: register commands to this server for near-instant availability.
# Leave blank to register global commands (may take longer to appear).
DISCORD_COMMAND_GUILD_ID=

# Use a long random value so stored report IP hashes cannot be reversed.
IP_HASH_SECRET=
